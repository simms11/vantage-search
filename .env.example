# Copy this file to .env and fill in all values before running docker-compose.
# NEVER commit .env to version control.

# Active Spring profiles. Leave empty for production (disables the DataSeeder).
# Set to "dev" to seed sample data on startup.
SPRING_PROFILES_ACTIVE=

# PostgreSQL password (shared between the db and api services)
SPRING_DATASOURCE_PASSWORD=

# Redis URL (used for distributed rate limiting and the JWT revocation cache)
REDIS_URL=redis://vantage_redis:6379

# JWT signing secret. Base64-encoded, must decode to at least 32 bytes.
# Generate: openssl rand -base64 32
APP_JWT_SECRET=

# Admin user credentials
# APP_ADMIN_PASSWORD must be a {bcrypt}-prefixed hash, e.g. {bcrypt}$2a$10$...
# Generate hash: htpasswd -bnBC 10 "" your_password | tr -d ':\n'
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
