<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-documents-table" author="alsahid">
        <createTable tableName="documents">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="summary" type="TEXT"/>

            <column name="embedding" type="vector(1536)"/>
        </createTable>
    </changeSet>

    <changeSet id="005-add-hnsw-index-on-document-embeddings" author="alsahid">
        <comment>Adding HNSW index for high-performance Conceptual Search</comment>
        <sql>
            -- vector_cosine_ops tells Postgres to measure the "distance" using Cosine Similarity
            CREATE INDEX idx_documents_embedding_hnsw
                ON documents
                USING hnsw (embedding vector_cosine_ops);
        </sql>
    </changeSet>

</databaseChangeLog>