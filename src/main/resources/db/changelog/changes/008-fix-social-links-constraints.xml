<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="011-fix-social-links-constraints" author="alsahid">
        <comment>
            client_social_links had no primary key (allowing duplicate rows) and no ON DELETE CASCADE
            (leaving orphaned rows when a client is deleted). Add a composite PK and re-create the FK
            with cascade delete.
        </comment>

        <addPrimaryKey
                tableName="client_social_links"
                columnNames="client_id, link"
                constraintName="pk_social_links"/>

        <dropForeignKeyConstraint
                baseTableName="client_social_links"
                constraintName="fk_social_links_client"/>

        <addForeignKeyConstraint
                baseTableName="client_social_links"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_social_links_client"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
