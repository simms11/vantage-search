<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-cascade-delete-documents" author="alsahid">
        <comment>
            Re-create the documents FK with ON DELETE CASCADE so deleting a client
            automatically removes their documents.
        </comment>

        <dropForeignKeyConstraint
                baseTableName="documents"
                constraintName="fk_documents_client"/>

        <addForeignKeyConstraint
                baseTableName="documents"
                baseColumnNames="client_id"
                referencedTableName="clients"
                referencedColumnNames="id"
                constraintName="fk_documents_client"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
